# Copy to .env and replace the placeholders. .env is gitignored.

POSTGRES_DB=rideconnect
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Host "db" is the Compose service name. The database container listens on 5432
# inside the network and is published on host port 9000.
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/rideconnect
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me

# Required so Spring can resolve jwt.secret. Token signing currently uses the
# key compiled into JwtUtil.
JWT_SECRET=change-me
